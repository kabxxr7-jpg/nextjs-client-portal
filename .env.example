# Supabase project (Settings -> API). The anon/publishable key is safe in the browser;
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Password shared by the three demo accounts (server only; used by one-click demo logins)
DEMO_PASSWORD=choose-a-long-random-string
